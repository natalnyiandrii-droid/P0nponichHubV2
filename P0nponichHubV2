			if input.KeyCode == Enum.KeyCode.Escape then
				waitingForKey = false
	
				if assignedKey then
					keybindButton.Text = assignedKey.Name
				else
					keybindButton.Text = originalText
				end
	
				return
			end
	
			assignedKey = input.KeyCode
			waitingForKey = false
			keybindButton.Text = assignedKey.Name
	
			return
		end
	
		if assignedKey and input.KeyCode == assignedKey then
