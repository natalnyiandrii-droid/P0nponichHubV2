local function C_1af()
local script = G2L["1af"];
	local TweenService = game:GetService("TweenService")
	local openButton = script.Parent
	local executor = openButton.Parent:WaitForChild("Main") -- ЗАМЕНИ "Executor" на реальное имя твоего фрейма
	
	local TWEEN_TIME = 0.25
	local EASING_STYLE = Enum.EasingStyle.Quad
	local EASING_DIRECTION = Enum.EasingDirection.Out
	
	local function getAllGuiObjects()
		local list = { executor }
		for _, obj in executor:GetDescendants() do
			if obj:IsA("GuiObject") then
				table.insert(list, obj)
			end
		end
		return list
	end
	
	local isAnimating = false
	
	openButton.MouseButton1Click:Connect(function()
		if isAnimating or executor.Visible then return end
		isAnimating = true
	
		openButton.Visible = false
		executor.Visible = true
	
		-- сразу делаем прозрачным перед плавным появлением
		for _, obj in getAllGuiObjects() do
			if obj:GetAttribute("OrigBgTransparency") ~= nil then
				obj.BackgroundTransparency = 1
			end
			if obj:GetAttribute("OrigTextTransparency") ~= nil then
				obj.TextTransparency = 1
			end
			if obj:GetAttribute("OrigImageTransparency") ~= nil then
				obj.ImageTransparency = 1
			end
		end
	
		local tweens = {}
		for _, obj in getAllGuiObjects() do
			local props = {}
			local bg = obj:GetAttribute("OrigBgTransparency")
			local txt = obj:GetAttribute("OrigTextTransparency")
			local img = obj:GetAttribute("OrigImageTransparency")
			if bg ~= nil then props.BackgroundTransparency = bg end
			if txt ~= nil then props.TextTransparency = txt end
			if img ~= nil then props.ImageTransparency = img end
			if next(props) then
				local tween = TweenService:Create(obj, TweenInfo.new(TWEEN_TIME, EASING_STYLE, EASING_DIRECTION), props)
				table.insert(tweens, tween)
			end
		end
	
		for _, tween in tweens do
			tween:Play()
		end
	
		local function finish()
			isAnimating = false
		end
	
		if tweens[1] then
			tweens[1].Completed:Connect(finish)
		else
			finish()
		end
	end)
end;
