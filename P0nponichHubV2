				editBox.TextXAlignment = itemName.TextXAlignment
				editBox.ClearTextOnFocus = false
				editBox.Parent = item
	
				data.EditBox = editBox
	
				editButton.Image = SAVE_IMAGE
				editButton.ImageRectOffset = Vector2.new(0, 0)
				editButton.ImageRectSize = Vector2.new(0, 0)
	
				editBox:CaptureFocus()
	
			else
	
				local newName = data.EditBox.Text
	
				if newName == "" then
					newName = "Waypoint"
				end
	
				itemName.Text = newName
				billboardTitle.Text = newName
	
				data.EditBox:Destroy()
				data.EditBox = nil
	
				itemName.Visible = true
				data.Editing = false
	
				editButton.Image = originalEditImage
				editButton.ImageRectOffset = originalEditOffset
				editButton.ImageRectSize = originalEditSize
			end
		end)
	
		nameBox.Text = ""
		iconIDBox.Text = ""
		iconPreview.Image = "rbxassetid://" .. DEFAULT_ICON
	end
	
	addButton.MouseButton1Click:Connect(createWaypoint)
	
	RunService.RenderStepped:Connect(function()
	
