-- StarterGui.ScreenGui.Main.Player.ScrollingFrame.Misc.SpeedSliderText.SpeedSlider.SliderLogic
local function C_64()
local script = G2L["64"];
	local player = game.Players.LocalPlayer
	local slider = script.Parent
	local button = slider.SpeedSliderButton
	local numberLabel = script.Parent.Parent.SpeedNumber
	local mainFrame = player.PlayerGui.ScreenGui.Main -- Путь к главному окну
	
	local UIS = game:GetService("UserInputService")
	local dragging = false
	
	local MAX_SPEED = 300
	local INITIAL_SPEED = 16
	
	local function updateSpeed(input)
	    local sliderAbsPos = slider.AbsolutePosition.X
	    local sliderAbsSize = slider.AbsoluteSize.X
	    
	    local fillAmount = math.clamp((input.Position.X - sliderAbsPos) / sliderAbsSize, 0, 1)
	    
	    -- Расползаем кнопку
	    button.Size = UDim2.new(fillAmount, 0, 1, 0)
	    
	    local speed = math.floor(fillAmount * MAX_SPEED)
	    numberLabel.Text = tostring(speed)
	    
	    if player.Character and player.Character:FindFirstChild("Humanoid") then
	        player.Character.Humanoid.WalkSpeed = speed
	    end
	end
	
	-- Включаем/выключаем драг главного окна
	local function setDraggingEnabled(enabled)
	    if mainFrame:FindFirstChild("UIDrag") then
	        mainFrame.UIDrag.Disabled = not enabled
	    end
	end
	
	-- Обработка нажатия
	slider.InputBegan:Connect(function(input)
	    if input.UserInputType == Enum.UserInputType.MouseButton1 then
	        dragging = true
	        setDraggingEnabled(false) -- Выключаем драг окна
	        updateSpeed(input)
	    end
	end)
	
	button.InputBegan:Connect(function(input)
	    if input.UserInputType == Enum.UserInputType.MouseButton1 then
	        dragging = true
	        setDraggingEnabled(false) -- Выключаем драг окна
	        updateSpeed(input)
	    end
	end)
	
	UIS.InputChanged:Connect(function(input)
	    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
	        updateSpeed(input)
	    end
	end)
	
	UIS.InputEnded:Connect(function(input)
	    if input.UserInputType == Enum.UserInputType.MouseButton1 then
	        dragging = false
	        setDraggingEnabled(true) -- Включаем драг окна обратно
	    end
	end)
	
	-- Начальная установка
	local initialFill = INITIAL_SPEED / MAX_SPEED
	button.Size = UDim2.new(initialFill, 0, 1, 0)
	numberLabel.Text = tostring(INITIAL_SPEED)
	
end;
task.spawn(C_64);
