local function C_10()
local script = G2L["10"];
	local TweenService = game:GetService("TweenService")
	
	local buttonsFrame = script.Parent
	local main = buttonsFrame.Parent
	
	local activeColor = Color3.fromRGB(38, 42, 49)
	local inactiveColor = Color3.fromRGB(17, 19, 22)
	
	local openTween = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local closeTween = TweenInfo.new(0.12, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	
	local busy = false
	
	local function getTargetFrame(button)
		return main:FindFirstChild(button.Name:gsub("Btn$", ""))
	end
	
	local function setButtonColor(button, active)
		TweenService:Create(
			button,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{BackgroundColor3 = active and activeColor or inactiveColor}
		):Play()
	end
	
	local function openFrame(target, clickedButton)
		if busy or not target then
			return
		end
	
		busy = true
	
		for _, button in ipairs(buttonsFrame:GetChildren()) do
			if button:IsA("TextButton") or button:IsA("ImageButton") then
				setButtonColor(button, button == clickedButton)
			end
		end
	
		for _, frame in ipairs(main:GetChildren()) do
			if frame:IsA("Frame") and frame ~= buttonsFrame and frame ~= target and frame.Visible then
				frame.Visible = false
			end
		end
	
		local originalPosition = target.Position
		target.Position = originalPosition + UDim2.new(0.02, 0, 0, 0)
		target.Visible = true
	
		TweenService:Create(
			target,
			openTween,
			{Position = originalPosition}
		):Play()
	
		task.delay(0.16, function()
			busy = false
		end)
	end
	
	for _, button in ipairs(buttonsFrame:GetChildren()) do
		if button:IsA("TextButton") or button:IsA("ImageButton") then
			setButtonColor(button, false)
	
			button.MouseButton1Click:Connect(function()
				openFrame(getTargetFrame(button), button)
			end)
		end
	end
	
	local home = main:FindFirstChild("Home")
	local homeButton = buttonsFrame:FindFirstChild("HomeBtn")
	
	if home then
		for _, frame in ipairs(main:GetChildren()) do
			if frame:IsA("Frame") and frame ~= buttonsFrame then
				frame.Visible = frame == home
			end
		end
	
		home.Visible = true
	
		if homeButton then
			setButtonColor(homeButton, true)
		end
	end
end;
