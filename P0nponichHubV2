		showButton.Image = SHOW_TEXTURE
		showButton.ImageRectOffset = SHOW_OFFSET
	
		local originalEditImage = editButton.Image
		local originalEditOffset = editButton.ImageRectOffset
		local originalEditSize = editButton.ImageRectSize
	
		local data = {
			Position = position,
			Marker = marker,
			Billboard = billboard,
			BillboardTitle = billboardTitle,
			DistanceLabel = distanceLabel,
			Item = item,
			Visible = true,
			Editing = false,
			EditBox = nil
		}
	
		table.insert(waypoints, data)
	
		deleteButton.MouseButton1Click:Connect(function()
	
			for i, waypoint in ipairs(waypoints) do
