local function C_8()
local script = G2L["8"];
	local TweenService = game:GetService("TweenService")
	
	local closeButton = script.Parent
	local executor = closeButton.Parent
	
	local TWEEN_TIME = 0.25
	local EASING_STYLE = Enum.EasingStyle.Quad
	local EASING_DIRECTION = Enum.EasingDirection.In
	
	local function getAllGuiObjects()
		local list = { executor }
		for _, obj in executor:GetDescendants() do
			if obj:IsA("GuiObject") then
				table.insert(list, obj)
			end
		end
		return list
	end
	
	local originalBgTransparency = {}
	local originalTextTransparency = {}
	local originalImageTransparency = {}
	
	for _, obj in getAllGuiObjects() do
		originalBgTransparency[obj] = obj.BackgroundTransparency
	
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			originalTextTransparency[obj] = obj.TextTransparency
		end
	
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			originalImageTransparency[obj] = obj.ImageTransparency
		end
	end
	
	local isAnimating = false
	
	closeButton.MouseButton1Click:Connect(function()
		if isAnimating or not executor.Visible then return end
		isAnimating = true
	
		local tweens = {}
	
		for _, obj in getAllGuiObjects() do
			local props = {}
	
			if originalBgTransparency[obj] ~= nil then
				props.BackgroundTransparency = 1
			end
	
			if originalTextTransparency[obj] ~= nil then
				props.TextTransparency = 1
			end
	
			if originalImageTransparency[obj] ~= nil then
				props.ImageTransparency = 1
			end
	
			if next(props) then
				local tween = TweenService:Create(obj, TweenInfo.new(TWEEN_TIME, EASING_STYLE, EASING_DIRECTION), props)
				table.insert(tweens, tween)
			end
		end
	
		for _, tween in tweens do
			tween:Play()
		end
	
		if tweens[1] then
			tweens[1].Completed:Connect(function()
				executor.Visible = false
				isAnimating = false
			end)
		else
			executor.Visible = false
			isAnimating = false
		end
	end)
	
end;
