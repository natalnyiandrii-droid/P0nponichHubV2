	local function getToggleEvent()
		local eventName = featureButton.Name .. "Toggle"
		local event = frame:FindFirstChild(eventName)
	
		if not event then
			event = Instance.new("BindableEvent")
			event.Name = eventName
			event.Parent = frame
		end
	
		return event
	end
	
	keybindButton.Activated:Connect(function()
		if waitingForKey then
			return
		end
	
		waitingForKey = true
		keybindButton.Text = "..."
	end)
	
