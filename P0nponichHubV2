local function C_9()
local script = G2L["9"];
	local TweenService = game:GetService("TweenService")
	local closeButton = script.Parent
	local executor = closeButton.Parent
	local openButton = executor.Parent:WaitForChild("OpenButton") -- OpenButton должен лежать рядом с фреймом (тот же родитель)
	
	local TWEEN_TIME = 0.25
	local EASING_STYLE = Enum.EasingStyle.Quad
	local EASING_DIRECTION = Enum.EasingDirection.In
	
	local function getAllGuiObjects()
		local list = { executor }
		for _, obj in executor:GetDescendants() do
			if obj:IsA("GuiObject") then
				table.insert(list, obj)
			end
		end
		return list
	end
	
	-- Сохраняем оригинальную прозрачность в Attribute (доступно и другому скрипту)
	for _, obj in getAllGuiObjects() do
		if obj:GetAttribute("OrigBgTransparency") == nil then
			obj:SetAttribute("OrigBgTransparency", obj.BackgroundTransparency)
		end
		if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and obj:GetAttribute("OrigTextTransparency") == nil then
			obj:SetAttribute("OrigTextTransparency", obj.TextTransparency)
		end
		if (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and obj:GetAttribute("OrigImageTransparency") == nil then
			obj:SetAttribute("OrigImageTransparency", obj.ImageTransparency)
		end
	end
	
	local isAnimating = false
	
	closeButton.MouseButton1Click:Connect(function()
		if isAnimating or not executor.Visible then return end
		isAnimating = true
	
		local tweens = {}
		for _, obj in getAllGuiObjects() do
			local props = {}
			if obj:GetAttribute("OrigBgTransparency") ~= nil then
				props.BackgroundTransparency = 1
			end
			if obj:GetAttribute("OrigTextTransparency") ~= nil then
				props.TextTransparency = 1
			end
			if obj:GetAttribute("OrigImageTransparency") ~= nil then
				props.ImageTransparency = 1
			end
			if next(props) then
				local tween = TweenService:Create(obj, TweenInfo.new(TWEEN_TIME, EASING_STYLE, EASING_DIRECTION), props)
				table.insert(tweens, tween)
			end
		end
	
		for _, tween in tweens do
			tween:Play()
		end
	
		local function finish()
			executor.Visible = false
			openButton.Visible = true
			isAnimating = false
		end
	
		if tweens[1] then
			tweens[1].Completed:Connect(finish)
		else
			finish()
		end
	end)
end;
