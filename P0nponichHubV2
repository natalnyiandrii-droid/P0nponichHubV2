local function C_78()
local script = G2L["78"];
	local button = script.Parent
	local label = button.ESPButton
	local TweenService = game:GetService("TweenService")
	local Players = game:GetService("Players")
	
	local enabled = false
	
	local toggleEvent = button:FindFirstChild("ToggleEvent")
	
	if not toggleEvent then
		toggleEvent = Instance.new("BindableEvent")
		toggleEvent.Name = "ToggleEvent"
		toggleEvent.Parent = button
	end
	
	local function addESP(player)
		if player == Players.LocalPlayer or not player.Character then return end
	
		local character = player.Character
	
		if not character:FindFirstChild("ESP_Highlight") then
			local highlight = Instance.new("Highlight")
			highlight.Name = "ESP_Highlight"
			highlight.Parent = character
		end
	
		if not character:FindFirstChild("ESP_NameTag") then
			local head = character:FindFirstChild("Head")
	
			if head then
				local billboard = Instance.new("BillboardGui")
				billboard.Name = "ESP_NameTag"
				billboard.Adornee = head
				billboard.Size = UDim2.new(0, 150, 0, 50)
				billboard.StudsOffset = Vector3.new(0, 3, 0)
				billboard.AlwaysOnTop = true
	
				local text = Instance.new("TextLabel")
				text.Size = UDim2.new(1, 0, 1, 0)
				text.BackgroundTransparency = 1
				text.Text = player.DisplayName
				text.TextScaled = true
				text.TextColor3 = Color3.new(1, 1, 1)
				text.Parent = billboard
	
				billboard.Parent = character
			end
		end
	end
	
	local function removeESP(player)
		if not player.Character then return end
	
		local highlight = player.Character:FindFirstChild("ESP_Highlight")
	
		if highlight then
			highlight:Destroy()
		end
	
		local nameTag = player.Character:FindFirstChild("ESP_NameTag")
	
		if nameTag then
			nameTag:Destroy()
		end
	end
	
	local function toggle()
		enabled = not enabled
	
		local targetPos = enabled
			and UDim2.new(0, button.AbsoluteSize.X - label.AbsoluteSize.X, 0, 0)
			or UDim2.new(0, 0, 0, 0)
	
		TweenService:Create(
			label,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Position = targetPos}
		):Play()
	
		for _, player in ipairs(Players:GetPlayers()) do
			if enabled then
				addESP(player)
			else
				removeESP(player)
			end
		end
	end
	
	button.Activated:Connect(toggle)
	toggleEvent.Event:Connect(toggle)
end;
task.spawn(C_78);
