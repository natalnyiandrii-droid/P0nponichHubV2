local function C_10f()
local script = G2L["10f"];
	local button = script.Parent
	local frame = button:FindFirstAncestor("Aimbot")
	local label = button:FindFirstChildWhichIsA("TextLabel", true)
	
	local TweenService = game:GetService("TweenService")
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	
	local enabled = false
	local fovGui
	local fovSegments = {}
	local dragging = false
	
	local MIN_RADIUS = 25
	local MAX_RADIUS = 500
	local DEFAULT_RADIUS = 100
	
	frame:SetAttribute("FOVRadius", frame:GetAttribute("FOVRadius") or DEFAULT_RADIUS)
	
	local toggleEvent = frame:FindFirstChild("ShowFOVToggle")
	
	if not toggleEvent then
		toggleEvent = Instance.new("BindableEvent")
		toggleEvent.Name = "ShowFOVToggle"
		toggleEvent.Parent = frame
	end
	
	local function getSlider()
		local textFrame = frame:FindFirstChild("FOVRadiusText", true)
	
		if not textFrame then
			return
		end
	
		local slider = textFrame:FindFirstChild("FovRadiusSlider", true)
	
		if not slider then
			return
		end
	
		local numberLabel = slider:FindFirstChild("FOVNumber", true)
		local sliderButton = slider:FindFirstChild("FOVRadiusSliderButton", true)
	
		return slider, numberLabel, sliderButton
	end
	
	local function updateNumber()
		local _, numberLabel = getSlider()
	
		if numberLabel then
			numberLabel.Text = tostring(math.round(frame:GetAttribute("FOVRadius") or DEFAULT_RADIUS))
		end
	end
	
	local function updateSlider()
		local slider, _, sliderButton = getSlider()
	
		if not slider or not sliderButton then
			return
		end
	
		local radius = frame:GetAttribute("FOVRadius") or DEFAULT_RADIUS
	
		local alpha = (radius - MIN_RADIUS) / (MAX_RADIUS - MIN_RADIUS)
		alpha = math.clamp(alpha, 0, 1)
	
		sliderButton.Position = UDim2.new(
			0,
			0,
			sliderButton.Position.Y.Scale,
			sliderButton.Position.Y.Offset
		)
	
		sliderButton.Size = UDim2.new(
			alpha,
			0,
			sliderButton.Size.Y.Scale,
			sliderButton.Size.Y.Offset
		)
	end
	
	local function setRadiusFromMouse(mouseX)
		local slider = getSlider()
	
		if not slider then
			return
		end
	
		local left = slider.AbsolutePosition.X
		local width = slider.AbsoluteSize.X
	
		if width <= 0 then
			return
		end
	
		local alpha = math.clamp((mouseX - left) / width, 0, 1)
	
		local radius = MIN_RADIUS + (MAX_RADIUS - MIN_RADIUS) * alpha
		radius = math.round(radius)
	
		frame:SetAttribute("FOVRadius", radius)
	
		updateNumber()
		updateSlider()
	
		if fovGui then
			local diameter = radius * 2
	
			for _, segment in ipairs(fovSegments) do
				local angle = segment:GetAttribute("Angle")
	
				if angle then
					local radians = math.rad(angle)
	
					segment.Position = UDim2.new(
						0.5,
						math.cos(radians) * radius,
						0.5,
						math.sin(radians) * radius
					)
	
					segment.Size = UDim2.fromOffset(
						math.max(2, diameter * 0.035),
						2
					)
	
					segment.Rotation = angle + 90
				end
			end
		end
	end
	
	local function createFOV()
		if fovGui then
			return
		end
	
		fovGui = Instance.new("ScreenGui")
		fovGui.Name = "FOVRainbowGui"
		fovGui.ResetOnSpawn = false
		fovGui.IgnoreGuiInset = true
		fovGui.DisplayOrder = 999
		fovGui.Parent = playerGui
	
		fovSegments = {}
	
		for i = 1, 120 do
			local segment = Instance.new("Frame")
	
			segment.Name = "RainbowSegment"
			segment.AnchorPoint = Vector2.new(0.5, 0.5)
			segment.BackgroundColor3 = Color3.fromHSV((i - 1) / 120, 1, 1)
			segment.BorderSizePixel = 0
			segment.Parent = fovGui
	
			segment:SetAttribute("Angle", (i - 1) * 3)
	
			table.insert(fovSegments, segment)
		end
	end
	
	local function updateFOV()
		if not fovGui then
			return
		end
	
		local radius = frame:GetAttribute("FOVRadius") or DEFAULT_RADIUS
		local diameter = radius * 2
	
		for i, segment in ipairs(fovSegments) do
			local angle = (i - 1) * 3
			local radians = math.rad(angle)
	
			segment.Position = UDim2.new(
				0.5,
				math.cos(radians) * radius,
				0.5,
				math.sin(radians) * radius
			)
	
			segment.Size = UDim2.fromOffset(
				math.max(2, diameter * 0.035),
				2
			)
	
			segment.Rotation = angle + 90
		end
	end
	
	local function removeFOV()
		if fovGui then
			fovGui:Destroy()
			fovGui = nil
			fovSegments = {}
		end
	end
	
	local function toggle()
		enabled = not enabled
	
		frame:SetAttribute("ShowFOV", enabled)
	
		if label then
			local buttonWidth = button.AbsoluteSize.X
			local labelWidth = label.AbsoluteSize.X
	
			local targetPos = enabled
				and UDim2.new(0, buttonWidth - labelWidth, 0, 0)
				or UDim2.new(0, 0, 0, 0)
	
			TweenService:Create(
				label,
				TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Position = targetPos}
			):Play()
		end
	
		if enabled then
			createFOV()
			updateNumber()
			updateSlider()
			updateFOV()
		else
			removeFOV()
		end
	end
	
	button.Activated:Connect(toggle)
	
	toggleEvent.Event:Connect(toggle)
	
	local slider, numberLabel, sliderButton = getSlider()
	
	if sliderButton then
		sliderButton.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				setRadiusFromMouse(input.Position.X)
			end
		end)
	end
	
	if slider then
		slider.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
				setRadiusFromMouse(input.Position.X)
			end
		end)
	end
	
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
	
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			setRadiusFromMouse(input.Position.X)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		updateNumber()
		updateSlider()
	
		if enabled and fovGui then
			local time = tick() * 0.15
	
			for i, segment in ipairs(fovSegments) do
				local hue = ((i / #fovSegments) + time) % 1
				segment.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
			end
	
			updateFOV()
		end
	end)
end;
