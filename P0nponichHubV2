					table.remove(waypoints, i)
					break
				end
			end
	
			if marker then
				marker:Destroy()
			end
	
			item:Destroy()
		end)
	
		showButton.MouseButton1Click:Connect(function()
	
			data.Visible = not data.Visible
			billboard.Enabled = data.Visible
	
			if data.Visible then
				showButton.ImageRectOffset = SHOW_OFFSET
			else
				showButton.ImageRectOffset = HIDE_OFFSET
			end
		end)
	
		editButton.MouseButton1Click:Connect(function()
	
			if not data.Editing then
	
				data.Editing = true
