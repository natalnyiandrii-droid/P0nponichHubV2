		distance.TextSize = 16
		distance.TextXAlignment = Enum.TextXAlignment.Left
		distance.Text = "0 m"
		distance.Parent = main
	
		return marker, billboard, title, distance
	end
	
	local function createWaypoint()
	
		local waypointName = nameBox.Text
	
		if waypointName == "" then
			waypointName = "Waypoint"
		end
	
		local iconID = getIconID()
	
		local character = player.Character or player.CharacterAdded:Wait()
		local root = character:WaitForChild("HumanoidRootPart")
	
		local position = root.Position
	
		local marker, billboard, billboardTitle, distanceLabel =
			createBillboard(waypointName, iconID, position)
	
		local item = template:Clone()
		item.Name = "Waypoint_" .. waypointName
		item.Visible = true
		item.Parent = waypointsFrame
	
		local itemName = item:WaitForChild("WaypointName")
		local itemIcon = item:WaitForChild("WaypointIcon")
		local deleteButton = item:WaitForChild("DeleteButton")
		local showButton = item:WaitForChild("ShowButton")
		local editButton = item:WaitForChild("EditButton")
	
