local function C_160()
local script = G2L["160"];
	local player = game.Players.LocalPlayer
	local viewportFrame = script.Parent -- LocalScript лежит внутри ViewportFrame "Avatar3D"
	
	viewportFrame.Active = true -- блокирует "протекание" ввода в карусель/драг под вьюпортом
	
	-- Камера
	local camera = Instance.new("Camera")
	camera.FieldOfView = 50
	viewportFrame.CurrentCamera = camera
	camera.Parent = viewportFrame
	
	-- Контейнер для 3D-модели
	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewportFrame
	
	-- Ждём персонажа
	local character = player.Character or player.CharacterAdded:Wait()
	character:WaitForChild("HumanoidRootPart")
	
	character.Archivable = true
	local charClone = character:Clone()
	
	if not charClone then
		warn("Не удалось клонировать персонажа!")
		return
	end
	
	for _, v in pairs(charClone:GetDescendants()) do
		if v:IsA("Script") or v:IsA("LocalScript") then
			v:Destroy()
		end
	end
	
	charClone.Parent = worldModel
	
	local light = Instance.new("PointLight")
	light.Brightness = 3
	light.Range = 20
	light.Parent = charClone:FindFirstChild("Head") or charClone.PrimaryPart
	
	local root = charClone:FindFirstChild("HumanoidRootPart")
	
	-- ===== Вращение и зум =====
	local distance = 5 -- было 8, теперь ближе -> модель крупнее
	local angleX, angleY = 0, 0
	local dragging = false
	local lastInput
	
	local function updateCamera()
		if not root then return end
		local offset = CFrame.Angles(0, math.rad(angleY), 0)
			* CFrame.Angles(math.rad(angleX), 0, 0)
			* CFrame.new(0, 0, -distance) -- минус, чтобы смотреть СПЕРЕДИ
		camera.CFrame = CFrame.new(root.Position + offset.Position, root.Position)
	end
	
	viewportFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			lastInput = input.Position
		end
	end)
	
	viewportFrame.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	
	game:GetService("UserInputService").InputChanged:Connect(function(input, gameProcessedEvent)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - lastInput
			angleY = angleY - delta.X * 0.5
			angleX = math.clamp(angleX - delta.Y * 0.5, -80, 80)
			lastInput = input.Position
			updateCamera()
		end
	end)
	
	viewportFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			distance = math.clamp(distance - input.Position.Z, 2, 15)
			updateCamera()
		end
	end)
	
	updateCamera()
	
	-- ===== ФУНКЦИЯ ДЛЯ БУДУЩЕЙ КОСМЕТИКИ =====
	local function applyCosmeticToBoth(itemToClone)
		local realItem = itemToClone:Clone()
		realItem.Parent = character
	
		local previewItem = itemToClone:Clone()
		previewItem.Parent = charClone
	
		return realItem, previewItem
	end
	
	-- Пример:
	-- local hat = game.ReplicatedStorage.Hats.Cap
	-- applyCosmeticToBoth(hat)
end;
